digraph G {
    rankdir=LR;
    graph [fontname="Helvetica", bgcolor="#0f172a", pad="0.6", splines=ortho];
    node  [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.3,0.15"];
    edge  [fontname="Helvetica", fontcolor="#94a3b8", fontsize=7, color="#475569", penwidth=0.9];

    // ── REQUIREMENT ENGINEERING ───────────────────────────────────────────
    subgraph cluster_req {
        label="① Requirement Engineering";
        fontcolor="#e0e7ff"; color="#334155"; style=dashed; fontsize=12;

        Confluence  [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="Confluence\n[IMPROVED]"];
        Jira        [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="Jira\n[IMPROVED]"];
    }

    // ── CODE / DATA ENGINEERING ───────────────────────────────────────────
    subgraph cluster_code {
        label="② Code / Data Engineering";
        fontcolor="#e0e7ff"; color="#334155"; style=dashed; fontsize=12;

        VSCode      [fillcolor="#34d399", fontcolor="#0f172a",
                     label="VS Code + Plugins\n[REPLACED: Text Editor]"];
        SonarQube   [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="SonarQube Enterprise\n[IMPROVED]"];
        GitHubGitLab [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="GitHub / GitLab\n(GitOps enabled)\n[IMPROVED]"];
        Maven       [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="Maven\n[IMPROVED]"];
        Nexus       [fillcolor="#34d399", fontcolor="#0f172a",
                     label="Nexus / Artifactory\n[NEW]"];
        Flyway      [fillcolor="#ffffff", fontcolor="#0f172a",
                     label="Flyway\n[KEPT]"];
    }

    // ── QUALITY ENGINEERING ───────────────────────────────────────────────
    subgraph cluster_quality {
        label="③ Quality Engineering";
        fontcolor="#e0e7ff"; color="#334155"; style=dashed; fontsize=12;

        Jbehave     [fillcolor="#ffffff", fontcolor="#0f172a",
                     label="JBehave\n[KEPT]"];
        Selenium    [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="Selenium\n[IMPROVED]"];
        Playwright  [fillcolor="#34d399", fontcolor="#0f172a",
                     label="Playwright\n[NEW]"];
        Jmeter      [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="JMeter\n[IMPROVED]"];
        k6          [fillcolor="#34d399", fontcolor="#0f172a",
                     label="k6\n[NEW]"];
    }

    // ── BUILD & RELEASE ENGINEERING ───────────────────────────────────────
    subgraph cluster_build {
        label="④ Build & Release Engineering";
        fontcolor="#e0e7ff"; color="#334155"; style=dashed; fontsize=12;

        XLDeploy    [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="XL Deploy\n[IMPROVED]"];
        ArgoCD      [fillcolor="#34d399", fontcolor="#0f172a",
                     label="ArgoCD\n(GitOps CD)\n[NEW]"];
    }

    // ── ENVIRONMENT ENGINEERING ───────────────────────────────────────────
    subgraph cluster_env {
        label="⑤ Environment Engineering";
        fontcolor="#e0e7ff"; color="#334155"; style=dashed; fontsize=12;

        Puppet      [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="Puppet\n[IMPROVED]"];
        Terraform   [fillcolor="#34d399", fontcolor="#0f172a",
                     label="Terraform\n(IaC)\n[NEW]"];
        Vault       [fillcolor="#34d399", fontcolor="#0f172a",
                     label="HashiCorp Vault\n(Secrets Mgmt)\n[NEW]"];
    }

    // ── SERVICE OPS ───────────────────────────────────────────────────────
    subgraph cluster_svcops {
        label="⑥ Service Ops";
        fontcolor="#e0e7ff"; color="#334155"; style=dashed; fontsize=12;

        ServiceNow  [fillcolor="#60a5fa", fontcolor="#0f172a",
                     label="ServiceNow\n(AIOps enabled)\n[IMPROVED]"];
        Datadog     [fillcolor="#34d399", fontcolor="#0f172a",
                     label="Datadog APM\n[NEW — Replaces OverOps]"];
        OverOps     [fillcolor="#f87171", fontcolor="#0f172a",
                     label="OverOps\n[REPLACED → Datadog]"];
    }

    // ── SECURITY ──────────────────────────────────────────────────────────
    subgraph cluster_security {
        label="⑦ Security Engineering";
        fontcolor="#e0e7ff"; color="#334155"; style=dashed; fontsize=12;

        OWASPZAP    [fillcolor="#34d399", fontcolor="#0f172a",
                     label="OWASP ZAP\n(DAST)\n[NEW]"];
        Trivy       [fillcolor="#34d399", fontcolor="#0f172a",
                     label="Trivy\n(Container/IaC Scan)\n[NEW]"];
    }

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Requirement Engineering
    // ═══════════════════════════════════════════════════════════════════════
    Confluence   -> Jira            [label="A24 A22 A2 A4.0"];
    Jira         -> Confluence      [label="A29"];

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Confluence → downstream
    // ═══════════════════════════════════════════════════════════════════════
    Confluence   -> Jbehave         [label="A39"];
    Confluence   -> Puppet          [label="A2 A4.0"];
    Confluence   -> Terraform       [label="IaC specs → provisioning" color="#34d399" fontcolor="#34d399"];

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Code Engineering
    // ═══════════════════════════════════════════════════════════════════════
    Jira         -> VSCode          [label="A330 (replaces TextEditor)"];
    VSCode       -> Jira            [label="A332"];
    VSCode       -> SonarQube       [label="A206 + IDE SAST"];
    SonarQube    -> GitHubGitLab    [label="A226 quality gate"];
    GitHubGitLab -> Maven           [label="A229 build trigger"];
    Maven        -> Nexus           [label="artefact publish" color="#34d399" fontcolor="#34d399"];
    Nexus        -> XLDeploy        [label="artefact fetch" color="#34d399" fontcolor="#34d399"];
    GitHubGitLab -> Selenium        [label="A229 test trigger"];
    Flyway       -> Flyway          [label="A212" style=dashed];
    Flyway       -> Selenium        [label="A232"];

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Quality Engineering
    // ═══════════════════════════════════════════════════════════════════════
    Jbehave      -> Selenium        [label="A46 A47"];
    Jbehave      -> Playwright      [label="BDD → E2E" color="#34d399" fontcolor="#34d399"];
    Jbehave      -> Jmeter          [label="A46 A47"];
    Jbehave      -> k6              [label="BDD → perf" color="#34d399" fontcolor="#34d399"];
    Jira         -> Jmeter          [label="A50.0"];
    Jira         -> k6              [label="perf test trigger" color="#34d399" fontcolor="#34d399"];
    Selenium     -> Jira            [label="A305 A306.0"];
    Playwright   -> Jira            [label="E2E results" color="#34d399" fontcolor="#34d399"];
    Jmeter       -> Jira            [label="A309.0 A310.0"];
    k6           -> Jira            [label="perf results" color="#34d399" fontcolor="#34d399"];

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Build & Release
    // ═══════════════════════════════════════════════════════════════════════
    Jira         -> XLDeploy        [label="A334 release gate"];
    GitHubGitLab -> ArgoCD          [label="GitOps sync" color="#34d399" fontcolor="#34d399"];
    ArgoCD       -> XLDeploy        [label="CD orchestration" color="#34d399" fontcolor="#34d399"];
    XLDeploy     -> Datadog         [label="deploy events" color="#34d399" fontcolor="#34d399"];

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Environment Engineering
    // ═══════════════════════════════════════════════════════════════════════
    ServiceNow   -> Puppet          [label="A128 A273.0"];
    Puppet       -> ServiceNow      [label="A115 A113 A136.0"];
    ServiceNow   -> VSCode          [label="A164 (replaces TextEditor)"];
    ServiceNow   -> Flyway          [label="A164"];
    Terraform    -> Puppet          [label="provision → config" color="#34d399" fontcolor="#34d399"];
    Vault        -> Terraform       [label="secrets injection" color="#34d399" fontcolor="#34d399"];
    Vault        -> GitHubGitLab    [label="CI secrets" color="#34d399" fontcolor="#34d399"];

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Security
    // ═══════════════════════════════════════════════════════════════════════
    GitHubGitLab -> Trivy           [label="container scan" color="#34d399" fontcolor="#34d399"];
    GitHubGitLab -> OWASPZAP        [label="DAST trigger" color="#34d399" fontcolor="#34d399"];
    Trivy        -> Jira            [label="vuln tickets" color="#34d399" fontcolor="#34d399"];
    OWASPZAP     -> Jira            [label="DAST findings" color="#34d399" fontcolor="#34d399"];

    // ═══════════════════════════════════════════════════════════════════════
    // EDGES — Observability
    // ═══════════════════════════════════════════════════════════════════════
    Datadog      -> Jira            [label="alert → incident" color="#34d399" fontcolor="#34d399"];
    Datadog      -> ServiceNow      [label="ITSM integration" color="#34d399" fontcolor="#34d399"];
    OverOps      -> XLDeploy        [label="A377.0 (legacy)" color="#f87171" fontcolor="#f87171" style=dashed];
    XLDeploy     -> OverOps         [label="A352 A354.0 (legacy)" color="#f87171" fontcolor="#f87171" style=dashed];
}